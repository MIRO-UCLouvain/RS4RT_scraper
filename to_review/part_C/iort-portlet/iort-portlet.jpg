    <script defer type="text/javascript">
        window.addEventListener('load', () => {
            console.log('isMobileDevice', window.isMobile)
            if(window.isMobile) {
                $('.row-news').addClass('swiper-wrapper').removeClass('row');
                $('.col-card-news').removeClass('col-lg-6').addClass('swiper-slide');
                // Inizializza Swiper
                var swiperNews = new Swiper('.swiper-container-news-mobile', {
                    slidesPerView: "auto",
                    centeredSlides: true,
                    autoplay: false,
                    clickable: true,
                    keyboard: true,
                    loop: true,
                    pagination: {
                        el: '.swiper-pagination',
                    },
                });
            }
        })
    </script>

</body>

